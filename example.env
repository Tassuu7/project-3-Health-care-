# PulseCare Enterprise Health Platform - Environment Configuration Example
PORT=3050
HOST=0.0.0.0
NODE_ENV=development

# System Security Configuration (Example placeholders - configure per deployment)
JWT_SECRET=pulsecare_development_jwt_secret_token_change_in_production
TOKEN_EXPIRY=24h
CORS_ORIGIN=http://localhost:3050

# Logging & Clinical Auditing
AUDIT_LOG_LEVEL=info
ENABLE_HIPAA_LOGGING=true

# Clinical Decision Support Engine Settings
CDS_ALERT_SEVERITY_MIN=MODERATE
ENABLE_DRUG_INTERACTION_ALERTS=true
ENABLE_SEPSIS_EARLY_WARNING=true

# Telehealth Signaling Service
TELEHEALTH_MOCK_SIGNALING=true
TELEHEALTH_SESSION_TIMEOUT_MINUTES=45

# Medical Billing & ICD-10 Coding
DEFAULT_BILLING_CURRENCY=USD
ENABLE_AUTO_CLAIM_SCRUBBING=true
